# ─────────────────────────────────────────────────────────────────────────────
# Frontend configuration — copy to .env and adjust.
#
# Only VITE_* variables reach the browser, and Vite INLINES them at build time:
# a production build bakes in whatever was set when it ran. Never put secrets
# here — anything below is readable by anyone who opens the app.
#
# The defaults assume the frontend and API share an origin, which is what the
# dev proxy and a normal reverse-proxy deployment both give you. Every value
# has a working default, so an empty .env still runs.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────────────
# Where the API lives. Leave as /api when the frontend is served from the same
# origin. Set a full URL when the API is on another host, e.g.
#   VITE_API_BASE_URL=https://api.mealhub.in/api
VITE_API_BASE_URL=/api

# Origin serving uploaded images (menu photos, UPI QR). Empty = same origin.
# MUST be set whenever VITE_API_BASE_URL points at another host, or images 404.
#   VITE_MEDIA_BASE_URL=https://api.mealhub.in
VITE_MEDIA_BASE_URL=

# Dev server only: where `npm run dev` proxies /api and /uploads.
# Ignored in production builds.
VITE_API_PROXY_TARGET=http://localhost:8000
VITE_DEV_PORT=5173

# ── Branding ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=Mealhub
VITE_APP_DESCRIPTION=Chef-curated lunch boxes delivered daily to your tech park.

# ── Locale ───────────────────────────────────────────────────────────────────
VITE_CURRENCY_SYMBOL=₹
VITE_LOCALE=en-IN
# Must match the backend's TIMEZONE. If these disagree, the client and server
# disagree about which day "today" is, around midnight and at the cutoff.
VITE_TIMEZONE=Asia/Kolkata

# ── Links ────────────────────────────────────────────────────────────────────
# WhatsApp channel shown on the public bulk-orders page.
VITE_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb8RVR81iUxhMVsuxV1O

# ── Refresh intervals (milliseconds) ─────────────────────────────────────────
# Lower means fresher data and more requests. Raise these if the API is remote
# or you are watching bandwidth.
VITE_POLL_WINDOW_MS=60000
VITE_POLL_MENU_MS=45000
VITE_POLL_ADMIN_MS=30000
VITE_POLL_ORDERS_MS=45000
